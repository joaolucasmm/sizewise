{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sizewise",
  "version": "0.1.0",
  "identifier": "io.github.joaolucasmm.sizewise",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sizewise",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "joaolucasmm",
    "category": "Utility",
    "shortDescription": "Find what is using your disk space",
    "longDescription": "Sizewise scans a drive or folder and shows which folders and Large files take up space. It only reads your files.",
    "copyright": "Copyright (c) 2026 joaolucasmm. MIT License.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
